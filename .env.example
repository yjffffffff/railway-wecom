# ==========================================
# 环境变量模板 - 复制为 .env 并填入真实值
# ==========================================

# --- 数据源 ---
# Tushare Pro Token（可选，配置后作为首选数据源；未配置则跳过）
# 获取: https://tushare.pro/register
TUSHARE_TOKEN=

# 东财直连（快照接口云端可用，K线接口易被断连，会自动降级到腾讯/新浪）
EM_OVERSEAS=true
EASTMONEY_ENABLED=true

# 腾讯行情直连（云端 IP 友好，日线主力兜底数据源）
TENCENT_ENABLED=true

# 是否启用 akshare（含新浪日线兜底，推荐开启）
AKSHARE_ENABLED=true

# 可选调优：东财请求重试/超时、数据源熔断冷却时间（秒）
# EM_MAX_RETRIES=5
# EM_TIMEOUT=10
# TENCENT_MAX_RETRIES=3
# TENCENT_TIMEOUT=10
# SOURCE_COOLDOWN_SECONDS=600

# --- 企业微信推送 ---
# 方式一：企微应用消息（推荐，支持@all、格式丰富）
# 1. 企业微信管理后台 -> 应用管理 -> 创建应用 -> 获取 AgentId 和 Secret
# 2. 我的企业 -> 企业信息 -> 获取 CorpID
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=

# 方式二：群机器人 Webhook（备用，配置简单但功能受限）
# 群设置 -> 添加群机器人 -> 复制 Webhook URL
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=1cf8fb0c-1072-4cab-94e5-d9cdb209a4fa

# --- 运行时 ---
LOG_LEVEL=INFO
TIMEZONE=Asia/Shanghai